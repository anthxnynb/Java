import java.util.Scanner;
public class Ej_02_Dia_de_la_semana_y_tipo_de_actividad {
    static String concat(Object a, Object b) { return String.valueOf(a) + String.valueOf(b); }
    static String upper(String a) { return a.toUpperCase(); }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = 0;
        String D = "";
        String T = "";
        boolean V = false;

        // Ejercicio: Día de la semana y tipo de actividad
        // Fuente: Semana 6, control múltiple; sustituye días del ZIP
        System.out.println(String.valueOf("Ingrese el dia (1 a 7):"));
        N = sc.nextInt();
        // Un dia se muestra una sola vez, con tipo de actividad
        V = true;
        switch (N) {
            case 1:
                D = "Lunes";
                break;
            case 2:
                D = "Martes";
                break;
            case 3:
                D = "Miercoles";
                break;
            case 4:
                D = "Jueves";
                break;
            case 5:
                D = "Viernes";
                break;
            case 6:
                D = "Sabado";
                break;
            case 7:
                D = "Domingo";
                break;
            default:
                V = false;
                break;
        }
        if (V) {
            if (N <= 5) {
                T = "Dia de clases";
            } else {
                T = "Fin de semana";
            }
            System.out.println(String.valueOf("Dia: ") + String.valueOf(D));
            System.out.println(String.valueOf("Actividad: ") + String.valueOf(T));
        } else {
            System.out.println(String.valueOf("Numero de dia no valido"));
        }
    }
}
