import java.util.Scanner;
public class Ej_03_Contar_y_sumar_multiplos_de_3_y_5 {
    static String concat(Object a, Object b) { return String.valueOf(a) + String.valueOf(b); }
    static String upper(String a) { return a.toUpperCase(); }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = 0;
        int I = 0;
        int C = 0;
        int S = 0;

        // Ejercicio: Contar y sumar múltiplos de 3 y 5
        // Fuente: ZIP original
        // Variables y datos del problema
        // Entrada de datos y validaciones
        System.out.println(String.valueOf("Ingrese N:"));
        N = sc.nextInt();
        // Proceso y cálculos
        C = 0;
        S = 0;
        for (I = 1; I <= N; I++) {
            if (I % 3 == 0  ||  I % 5 == 0) {
                C = C + 1;
                S = S + I;
            }
        }
        System.out.println(String.valueOf("Cantidad de multiplos: ") + String.valueOf(C));
        System.out.println(String.valueOf("Suma de multiplos: ") + String.valueOf(S));
    }
}
