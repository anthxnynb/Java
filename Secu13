import java.util.Scanner;
public class Ej_13_pseudocodigo_area_de_un_triangulo {
    static String concat(Object a, Object b) { return String.valueOf(a) + String.valueOf(b); }
    static String upper(String a) { return a.toUpperCase(); }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double B = 0.0;
        double H = 0.0;
        double A = 0.0;

        // Ejercicio: pseudocódigo área de un triangulo
        // Fuente: ZIP original
        // Variables y datos del problema
        // Entrada de datos y validaciones
        System.out.println(String.valueOf("Ingresar la base:"));
        B = sc.nextDouble();
        System.out.println(String.valueOf("Ingresar la altura:"));
        H = sc.nextDouble();
        // Proceso y cálculos
        A = (B*H)/2;
        System.out.println(String.valueOf("La area del triangulo es:") + String.valueOf(A));
    }
}
